# Application
APP_NAME="Fleet Management Platform"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000

# Database (Aurora PostgreSQL AWS)
DATABASE_URL="postgresql://your_user:your_password@your-aurora-cluster.rds.amazonaws.com:5432/your_database"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (Docker network - uses internal port 6379, external 6380)
REDIS_URL="redis://redis:6379/0"
REDIS_CACHE_TTL=3600

# Security
SECRET_KEY="your-super-secret-key-change-this-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# SSO Handoff (F4-01/F4-02) - segredo compartilhado com a plataforma padrao da empresa
# NAO reaproveitar o valor de SECRET_KEY - deve ser um segredo dedicado a essa integracao
SSO_SHARED_SECRET="change-this-shared-secret-in-production"
SSO_TICKET_MAX_AGE_SECONDS=60

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Sentry (Error Tracking)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9091

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
API_KEY_RATE_LIMIT_PER_HOUR=1000

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# Timezone
TIMEZONE="America/Sao_Paulo"
